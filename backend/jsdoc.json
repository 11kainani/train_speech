{
    "tags": {
      "allowUnknownTags": true
    },
    "source": {
      "include": ["."],
      "exclude": ["node_modules", "tests"],
      "includePattern": ".+\\.js(doc|x)?$",
      "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
      "destination": "./docs",
      "recurse": true,
      "readme": "./README.md"
    }
  }
  